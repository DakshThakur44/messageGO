# Chat Gateway Server Configuration
PORT=8080
ENV=development

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgrespassword@127.0.0.1:5433/messagego_db?sslmode=disable

# Redis Cache & Presence
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT Authentication Secret (Must match auth_service JWT_ACCESS_SECRET)
JWT_ACCESS_SECRET=super_secret_jwt_access_key_messagego_2026_secure
