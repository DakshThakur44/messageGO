		{
			"name": "3. Token Management & Sessions",
			"item": [
				{
					"name": "Refresh Access Token (Rotation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data) {",
									"    if (jsonData.data.access_token) {",
									"        pm.collectionVariables.set('access_token', jsonData.data.access_token);",
									"        pm.environment.set('access_token', jsonData.data.access_token);",
									"        pm.globals.set('access_token', jsonData.data.access_token);",
									"    }",
									"    if (jsonData.data.refresh_token) {",
									"        pm.collectionVariables.set('refresh_token', jsonData.data.refresh_token);",
									"        pm.environment.set('refresh_token', jsonData.data.refresh_token);",
									"        pm.globals.set('refresh_token', jsonData.data.refresh_token);",
									"    }",
									"}",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh"
							]
						},
						"description": "Exchanges an existing Refresh Token for a new pair of Access and Refresh tokens (Token Rotation)."
					},
					"response": []
				},
				{
					"name": "Logout (Revoke Session)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Revokes current refresh token session and blacklists the active Access Token."
					},
					"response": []
				}
			]
		},
